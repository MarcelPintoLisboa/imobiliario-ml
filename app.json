{
  "expo": {
    "name": "Imobiliário ML",
    "slug": "imobiliario-ml",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "imobiliarioml",
    "backgroundColor": "#0B0C12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imobiliarioml.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.imobiliarioml.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0C12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Imobiliário ML",
      "themeColor": "#0B0C12",
      "backgroundColor": "#0B0C12"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C12"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para montar o portfólio dos imóveis e a logo da imobiliária.",
          "cameraPermission": "O app usa a câmera para fotografar os imóveis durante a captação.",
          "microphonePermission": "O app usa o microfone para você descrever o imóvel por voz."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O app usa o microfone para você descrever o imóvel por voz.",
          "speechRecognitionPermission": "O app transcreve sua fala para preencher as características do imóvel.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
